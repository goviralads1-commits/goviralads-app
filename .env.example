# =============================================
# GOVIRALADS - ENVIRONMENT CONFIGURATION
# =============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
#
# FREE HOSTING STACK:
# - Frontend: Vercel (free)
# - Backend: Railway or Render (free tier)
# - Database: MongoDB Atlas (free 512MB)
# - Email: Gmail/Brevo/Zoho SMTP (free)
# - Domain: goviralads.com

# =================================
# SERVER
# =================================
# Railway/Render will auto-assign PORT
PORT=5000
NODE_ENV=production

# =================================
# DATABASE (MongoDB Atlas - FREE)
# =================================
# 1. Go to mongodb.com/atlas
# 2. Create free M0 cluster
# 3. Create database user
# 4. Whitelist 0.0.0.0/0 for Railway/Render
# 5. Get connection string

# Development
# MONGODB_URI=mongodb://localhost:27017/goviralads

# Production (MongoDB Atlas FREE)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/goviralads?retryWrites=true&w=majority

# =================================
# JWT AUTHENTICATION
# =================================
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_64_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=7d

# =================================
# CORS (allowed origins)
# =================================
# Development
# CORS_ORIGINS=http://localhost:5173,http://localhost:5175

# Production (Update with your Vercel URLs)
# Format: https://your-admin.vercel.app,https://your-client.vercel.app
# Or custom domain: https://admin.goviralads.com,https://app.goviralads.com
CORS_ORIGINS=https://admin.goviralads.com,https://app.goviralads.com

# =================================
# EMAIL CONFIGURATION (Resend API)
# =================================
# Sign up at https://resend.com (free tier: 100 emails/day)
# 1. Create account and verify domain
# 2. Generate API key from dashboard
# 3. Set variables below

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@goviralads.com
EMAIL_FROM_NAME=Go Viral Ads

# --- LEGACY SMTP (deprecated, use Resend instead) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# =================================
# ADMIN NOTIFICATIONS
# =================================
# Admin receives: client ticket replies, overdue alerts, purchase notifications
ADMIN_EMAIL=admin@goviralads.com

# =================================
# APPLICATION URLs
# =================================
ADMIN_URL=https://admin.goviralads.com
CLIENT_URL=https://app.goviralads.com
API_URL=https://api.goviralads.com

# =================================
# REMINDERS (in hours)
# =================================
REMINDER_HOURS_BEFORE=24
OVERDUE_CHECK_INTERVAL=3600000

# =================================
# SECURITY
# =================================
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# =================================
# FILE UPLOADS (Cloudinary)
# =================================
# Sign up at https://cloudinary.com (free tier: 25GB storage + 25GB bandwidth/month)
# 1. Create account → Dashboard → copy Cloud Name, API Key, API Secret
# 2. Images are stored in folder: goviralads/chat
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# =================================
# CHAT MEDIA (Cloudflare R2) - Phase 1 foundation
# =================================
# Used ONLY for future chat video/audio attachments.
# Images keep using Cloudinary above - unaffected.
#
# Manual setup (one-time):
# 1. Cloudflare dashboard -> R2 -> Create bucket (PRIVATE, no public access)
# 2. R2 -> Manage R2 -> API tokens -> Create token -> "Object Read & Write",
#    apply to just this bucket -> copy Account ID / Access Key ID / Secret
# 3. Bucket -> Settings -> CORS: allow PUT/GET/HEAD from
#    https://app.goviralads.com and https://admin.goviralads.com
# 4. Bucket -> Lifecycle rules: delete objects older than MEDIA_RETENTION_DAYS
# 5. Set CHAT_MEDIA_ENABLED=true ONLY after all of the above is done.

# Feature flag - must stay 'false' until R2 is fully configured
CHAT_MEDIA_ENABLED=false

# Cloudflare account ID (from R2 overview page)
R2_ACCOUNT_ID=
# API token credentials (Object Read & Write, bucket-scoped)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Private bucket name
R2_BUCKET_NAME=

# Media retention in days (matches the R2 lifecycle rule you configure)
MEDIA_RETENTION_DAYS=10

# Per-file size limits in MB
MEDIA_MAX_VIDEO_MB=500
MEDIA_MAX_AUDIO_MB=25

# =================================
# FIREBASE ADMIN SDK (Push Notifications)
# =================================
# Go to https://console.firebase.google.com
# 1. Project settings → Service accounts → Generate new private key
# 2. Copy the entire JSON content and paste as a single line
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}
